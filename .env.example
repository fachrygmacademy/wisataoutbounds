# Konfigurasi Supabase untuk Malang Batu Outbound
# Ganti nilai di bawah ini dengan Project URL dan Anon Key dari dashboard Supabase Anda:
# Menu Dashboard: Project Settings -> API -> Project URL & Project API Keys (anon public)

PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
