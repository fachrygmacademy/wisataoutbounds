---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig, getWhatsAppUrl } from '../data/site';
import { catalogPackages } from '../data/packages';

const waDirectLink = getWhatsAppUrl('Halo, saya ingin menanyakan pemesanan paket outbound di Malang Batu.');

// Kumpulkan seluruh nama paket & subprogram untuk dropdown pilihan
const packageOptions: string[] = [];
catalogPackages.forEach((pkg) => {
  packageOptions.push(pkg.title);
  pkg.programs.forEach((prog) => {
    packageOptions.push(`${pkg.title} - ${prog.title}`);
  });
});
---

<BaseLayout
  title="Beli Paket & Kontak | Malang Batu Outbound"
  description="Pemesanan dan pembelian paket outbound, gathering perusahaan, outing keluarga, dan outbound sekolah di Malang & Kota Batu. Isi form kontak untuk konfirmasi jadwal dan penawaran resmi."
  canonicalPath="/kontak/"
  activePath="/kontak/"
>
  <!-- 1. DEDICATED HERO BANNER -->
  <section class="position-relative overflow-hidden py-4 py-md-5 text-white" style="background: linear-gradient(135deg, #102A43 0%, #0B1F33 100%);">
    <div class="position-absolute top-0 start-50 translate-middle-x w-100 h-100 pointer-events-none" style="background: radial-gradient(circle at 50% 15%, rgba(101, 183, 232, 0.14) 0%, transparent 70%);"></div>

    <div class="container position-relative z-1 py-2 py-md-3 text-center">
      <!-- Breadcrumb Nav -->
      <nav aria-label="breadcrumb" class="mb-3 d-inline-block">
        <ol class="breadcrumb small mb-0 px-3 py-1.5 rounded-pill" style="background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(4px);">
          <li class="breadcrumb-item"><a href="/" class="text-white-50 text-decoration-none">Beranda</a></li>
          <li class="breadcrumb-item active" style="color: #65B7E8;" aria-current="page">Kontak &amp; Pemesanan Paket</li>
        </ol>
      </nav>

      <!-- Badge Pill -->
      <div class="d-block mb-3">
        <span class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill" style="background-color: rgba(101, 183, 232, 0.15); border: 1px solid rgba(101, 183, 232, 0.35); color: #65B7E8; font-size: 0.82rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">
          <span style="display: inline-block; width: 7px; height: 7px; border-radius: 50%; background-color: #25D366;"></span> Form Pemesanan Paket
        </span>
      </div>

      <!-- Main Heading H1 -->
      <h1 class="display-5 fw-bold text-white mb-3 tracking-tight">
        Beli Paket Outbound &amp; Hubungi Kami
      </h1>

      <!-- Subtitle Description -->
      <p class="lead text-white text-opacity-75 mb-0 mx-auto" style="max-width: 720px; font-size: 1.05rem; line-height: 1.7;">
        Silakan lengkapi formulir di bawah ini untuk memesan paket outbound pilihan Anda. Data pesanan akan langsung tercatat di database kami dan tim kami akan segera menghubungi Anda untuk konfirmasi jadwal serta penawaran terbaik.
      </p>
    </div>
  </section>

  <!-- 2. FORM & INFO SECTION -->
  <section class="py-5 bg-light">
    <div class="container py-lg-3">
      <div class="row g-4 g-lg-5">
        <!-- Kolom Kiri: Form Pembelian Paket -->
        <div class="col-12 col-lg-7">
          <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
            <div class="d-flex align-items-center gap-2.5 mb-4">
              <span class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 40px; height: 40px; background-color: rgba(37, 99, 166, 0.12); color: var(--color-secondary-blue);">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                </svg>
              </span>
              <div>
                <h2 class="h4 fw-bold text-dark mb-0">Formulir Pembelian Paket</h2>
                <small class="text-muted">Isi data kontak &amp; detail pesanan Anda</small>
              </div>
            </div>

            <!-- Feedback Alert (Sukses / Error) -->
            <div id="formAlert" class="alert d-none mb-4 rounded-3" role="alert"></div>

            <form id="kontakForm" novalidate>
              <!-- Baris 1: Nama & Telepon (WhatsApp) -->
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                  <label for="nama" class="form-label fw-semibold small text-dark">
                    Nama Lengkap / PIC <span class="text-danger">*</span>
                  </label>
                  <input
                    type="text"
                    class="form-control rounded-3 py-2.5"
                    id="nama"
                    name="nama"
                    placeholder="Contoh: Bpk. Hendra Pratama"
                    required
                  />
                  <div class="invalid-feedback small">Nama lengkap wajib diisi.</div>
                </div>

                <div class="col-12 col-md-6">
                  <label for="telepon" class="form-label fw-semibold small text-dark">
                    Nomor WhatsApp / HP <span class="text-danger">*</span>
                  </label>
                  <input
                    type="tel"
                    class="form-control rounded-3 py-2.5"
                    id="telepon"
                    name="telepon"
                    placeholder="Contoh: 081234567890"
                    required
                  />
                  <div class="invalid-feedback small">Nomor WhatsApp wajib diisi untuk konfirmasi.</div>
                </div>
              </div>

              <!-- Baris 2: Email & Nama Instansi / Perusahaan -->
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                  <label for="email" class="form-label fw-semibold small text-dark">
                    Alamat Email <span class="text-muted fw-normal">(Opsional)</span>
                  </label>
                  <input
                    type="email"
                    class="form-control rounded-3 py-2.5"
                    id="email"
                    name="email"
                    placeholder="nama@perusahaan.com"
                  />
                </div>

                <div class="col-12 col-md-6">
                  <label for="nama_instansi" class="form-label fw-semibold small text-dark">
                    Nama Instansi / Perusahaan <span class="text-muted fw-normal">(Opsional)</span>
                  </label>
                  <input
                    type="text"
                    class="form-control rounded-3 py-2.5"
                    id="nama_instansi"
                    name="nama_instansi"
                    placeholder="Contoh: PT Sumber Rejeki / Komunitas"
                  />
                </div>
              </div>

              <!-- Baris 3: Pilihan Paket yang Dibeli -->
              <div class="mb-3">
                <label for="paket" class="form-label fw-semibold small text-dark">
                  Pilihan Paket yang Ingin Dibeli <span class="text-danger">*</span>
                </label>
                <select class="form-select rounded-3 py-2.5" id="paket" name="paket" required>
                  <option value="" disabled selected>-- Pilih Paket Outbound --</option>
                  {packageOptions.map((opt) => (
                    <option value={opt}>{opt}</option>
                  ))}
                  <option value="Paket Kustom / Konsultasi Khusus">Paket Kustom / Konsultasi Khusus</option>
                </select>
                <div class="invalid-feedback small">Silakan pilih paket outbound yang diinginkan.</div>
              </div>

              <!-- Baris 4: Estimasi Peserta & Tanggal Kegiatan -->
              <div class="row g-3 mb-3">
                <div class="col-12 col-md-6">
                  <label for="jumlah_peserta" class="form-label fw-semibold small text-dark">
                    Perkiraan Jumlah Peserta <span class="text-muted fw-normal">(Orang)</span>
                  </label>
                  <input
                    type="number"
                    min="1"
                    class="form-control rounded-3 py-2.5"
                    id="jumlah_peserta"
                    name="jumlah_peserta"
                    placeholder="Contoh: 50"
                  />
                </div>

                <div class="col-12 col-md-6">
                  <label for="tanggal_kegiatan" class="form-label fw-semibold small text-dark">
                    Estimasi Tanggal Kegiatan
                  </label>
                  <input
                    type="date"
                    class="form-control rounded-3 py-2.5"
                    id="tanggal_kegiatan"
                    name="tanggal_kegiatan"
                  />
                </div>
              </div>

              <!-- Baris 5: Pesan / Catatan Khusus -->
              <div class="mb-4">
                <label for="pesan" class="form-label fw-semibold small text-dark">
                  Catatan Tambahan / Kebutuhan Khusus <span class="text-muted fw-normal">(Opsional)</span>
                </label>
                <textarea
                  class="form-control rounded-3 py-2"
                  id="pesan"
                  name="pesan"
                  rows="3"
                  placeholder="Ceritakan tujuan kegiatan, preferensi lokasi/venue, fasilitas penginapan, atau kebutuhan khusus lainnya..."
                ></textarea>
              </div>

              <!-- Tombol Submit Beli Paket -->
              <button
                type="submit"
                id="submitBtn"
                class="btn-mbo-primary w-100 py-3 rounded-pill fw-bold fs-6 d-inline-flex align-items-center justify-content-center gap-2 border-0 shadow-sm"
              >
                <svg id="cartIcon" xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5M3.102 4l1.313 7h8.17l1.313-7zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4m7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4m-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2m7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2"/>
                </svg>
                <span id="btnText">Kirim Pesanan &amp; Beli Paket</span>
                <span id="spinner" class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span>
              </button>

              <div class="text-center mt-3 small text-muted">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="#25D366" class="me-1" viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M8 0a8 8 0 1 0 8 8A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"/>
                </svg>
                Data Anda aman dan terkirim otomatis ke sistem database kami.
              </div>
            </form>
          </div>
        </div>

        <!-- Kolom Kanan: Info Kontak & Layanan Cepat -->
        <div class="col-12 col-lg-5">
          <div class="d-flex flex-column gap-4">
            <!-- Card 1: WhatsApp Fast Response -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
              <div class="d-flex align-items-center gap-3 mb-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle flex-shrink-0" style="width: 44px; height: 44px; background-color: rgba(37, 211, 102, 0.15); color: #25D366;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.364 2.76 1.057 3.96L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.707 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/>
                  </svg>
                </div>
                <div>
                  <h3 class="h6 fw-bold mb-0 text-dark">Konsultasi WhatsApp Cepat</h3>
                  <small class="text-muted">Respon cepat setiap hari</small>
                </div>
              </div>
              <p class="small text-muted mb-3">
                Butuh respon instan atau diskusi teknis langsung dengan tim outbound kami? Hubungi kami via WhatsApp:
              </p>
              <a
                href={waDirectLink}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-mbo-whatsapp w-100 py-2.5 rounded-pill small fw-semibold text-center"
              >
                <span>Chat WhatsApp: {siteConfig.phoneDisplay}</span>
              </a>
            </div>

            <!-- Card 2: Jam Kerja & Area Layanan -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
              <h3 class="h6 fw-bold text-dark mb-3">Informasi Operasional</h3>
              <ul class="list-unstyled mb-0 d-flex flex-column gap-3 small text-muted">
                <li class="d-flex align-items-start gap-2.5">
                  <span class="text-primary mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M8 3.5a.5.5 0 0 0-1 0V9a.5.5 0 0 0 .252.434l3.5 2a.5.5 0 0 0 .496-.868L8 8.71V3.5z"/>
                      <path d="M8 16A8 8 0 1 0 8 0a8 8 0 0 0 0 16zm7-8A7 7 0 1 1 1 8a7 7 0 0 1 14 0z"/>
                    </svg>
                  </span>
                  <div>
                    <strong class="text-dark d-block">Jam Layanan:</strong>
                    {siteConfig.operatingHours}
                  </div>
                </li>
                <li class="d-flex align-items-start gap-2.5">
                  <span class="text-primary mt-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                      <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6"/>
                    </svg>
                  </span>
                  <div>
                    <strong class="text-dark d-block">Cakupan Wilayah:</strong>
                    {siteConfig.addressSummary}
                  </div>
                </li>
              </ul>
            </div>

            <!-- Card 3: Jaminan Layanan -->
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white">
              <h3 class="h6 fw-bold text-dark mb-3">Mengapa Memesan Bersama Kami?</h3>
              <div class="d-flex flex-column gap-2.5 small text-muted">
                <div class="d-flex align-items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="#2563A6" viewBox="0 0 16 16">
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                  </svg>
                  <span>Fasilitator &amp; Master Game Bersertifikasi</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="#2563A6" viewBox="0 0 16 16">
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                  </svg>
                  <span>Peralatan Simulasi Lengkap &amp; SOP Medis Siaga</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="#2563A6" viewBox="0 0 16 16">
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                  </svg>
                  <span>Rincian Biaya Transparan Tanpa Biaya Tersembunyi</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                  <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="#2563A6" viewBox="0 0 16 16">
                    <path d="M10.97 4.97a.75.75 0 0 1 1.07 1.05l-3.99 4.99a.75.75 0 0 1-1.08.02L4.324 8.384a.75.75 0 1 1 1.06-1.06l2.094 2.093 3.473-4.425z"/>
                  </svg>
                  <span>Lokasi Venue Terbaik Pegunungan Malang &amp; Kota Batu</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { simpanKontak } from '../lib/supabase';

  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('kontakForm') as HTMLFormElement | null;
    const paketSelect = document.getElementById('paket') as HTMLSelectElement | null;
    const formAlert = document.getElementById('formAlert') as HTMLDivElement | null;
    const submitBtn = document.getElementById('submitBtn') as HTMLButtonElement | null;
    const btnText = document.getElementById('btnText') as HTMLSpanElement | null;
    const spinner = document.getElementById('spinner') as HTMLSpanElement | null;
    const cartIcon = document.getElementById('cartIcon') as SVGElement | null;

    // 1. Tangkap parameter URL ?paket=... dan pilih secara otomatis di dropdown
    const urlParams = new URLSearchParams(window.location.search);
    const selectedPaketFromUrl = urlParams.get('paket');

    if (selectedPaketFromUrl && paketSelect) {
      const decodedPaket = decodeURIComponent(selectedPaketFromUrl).trim();
      let matched = false;

      // Cari opsi yang persis atau mirip
      for (let i = 0; i < paketSelect.options.length; i++) {
        const optVal = paketSelect.options[i].value;
        if (optVal.toLowerCase() === decodedPaket.toLowerCase() || optVal.toLowerCase().includes(decodedPaket.toLowerCase())) {
          paketSelect.selectedIndex = i;
          matched = true;
          break;
        }
      }

      // Jika nama kustom tidak ada di daftar, tambahkan sebagai opsi baru dan pilih
      if (!matched && decodedPaket) {
        const newOption = new Option(decodedPaket, decodedPaket, true, true);
        paketSelect.add(newOption, 1);
        paketSelect.selectedIndex = 1;
      }
    }

    // 2. Handle pengiriman form kontak ke database Supabase
    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault();

        // Validasi Bootstrap
        if (!form.checkValidity()) {
          e.stopPropagation();
          form.classList.add('was-validated');
          return;
        }

        form.classList.add('was-validated');

        // Ambil nilai field form
        const formData = new FormData(form);
        const nama = (formData.get('nama') as string || '').trim();
        const telepon = (formData.get('telepon') as string || '').trim();
        const email = (formData.get('email') as string || '').trim() || undefined;
        const nama_instansi = (formData.get('nama_instansi') as string || '').trim() || undefined;
        const paket = (formData.get('paket') as string || '').trim();
        const jumlah_peserta_raw = formData.get('jumlah_peserta') as string;
        const jumlah_peserta = jumlah_peserta_raw ? parseInt(jumlah_peserta_raw, 10) : null;
        const tanggal_kegiatan = (formData.get('tanggal_kegiatan') as string || '').trim() || null;
        const pesan = (formData.get('pesan') as string || '').trim() || undefined;

        // UI Loading state
        if (submitBtn && btnText && spinner) {
          submitBtn.disabled = true;
          btnText.textContent = 'Menyimpan pesanan...';
          spinner.classList.remove('d-none');
          if (cartIcon) cartIcon.classList.add('d-none');
        }

        if (formAlert) {
          formAlert.className = 'alert d-none mb-4 rounded-3';
          formAlert.textContent = '';
        }

        try {
          const res = await simpanKontak({
            nama,
            telepon,
            email,
            nama_instansi,
            paket,
            jumlah_peserta,
            tanggal_kegiatan,
            pesan
          });

          if (res.success) {
            if (formAlert) {
              formAlert.className = 'alert alert-success mb-4 rounded-3 d-block';
              formAlert.innerHTML = `
                <div class="d-flex align-items-center gap-2 mb-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zm-3.97-3.03a.75.75 0 0 0-1.08.022L7.477 9.417 5.384 7.323a.75.75 0 0 0-1.06 1.06L6.97 11.03a.75.75 0 0 0 1.079-.02l3.992-4.99a.75.75 0 0 0-.01-1.05z"/>
                  </svg>
                  <strong>Pesanan Paket Berhasil Dikirim!</strong>
                </div>
                <div class="small">Terima kasih <strong>${nama}</strong>. Pembelian paket <strong>${paket}</strong> telah tersimpan di database kontak kami. Tim Malang Batu Outbound akan segera menghubungi nomor WhatsApp Anda (<strong>${telepon}</strong>).</div>
              `;
            }
            form.reset();
            form.classList.remove('was-validated');
            form.scrollIntoView({ behavior: 'smooth', block: 'center' });
          } else {
            if (formAlert) {
              formAlert.className = 'alert alert-danger mb-4 rounded-3 d-block';
              formAlert.innerHTML = `
                <div class="d-flex align-items-center gap-2 mb-1">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M7.938 2.016A.13.13 0 0 1 8.002 2a.13.13 0 0 1 .063.016.15.15 0 0 1 .054.057l6.857 11.667c.036.06.035.124.002.183a.2.2 0 0 1-.054.06.1.1 0 0 1-.066.017H1.146a.1.1 0 0 1-.066-.017.2.2 0 0 1-.054-.06.18.18 0 0 1 .002-.183L7.884 2.073a.15.15 0 0 1 .054-.057zm1.044-.45a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.713c.889 0 1.438-.99.98-1.767z"/>
                    <path d="M7.002 12a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 5.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0z"/>
                  </svg>
                  <strong>Gagal Mengirim Data</strong>
                </div>
                <div class="small">${res.error || 'Terjadi kesalahan saat menyimpan ke database.'}</div>
              `;
            }
          }
        } catch (err: any) {
          if (formAlert) {
            formAlert.className = 'alert alert-danger mb-4 rounded-3 d-block';
            formAlert.textContent = err?.message || 'Terjadi kesalahan tidak terduga.';
          }
        } finally {
          if (submitBtn && btnText && spinner) {
            submitBtn.disabled = false;
            btnText.textContent = 'Kirim Pesanan & Beli Paket';
            spinner.classList.add('d-none');
            if (cartIcon) cartIcon.classList.remove('d-none');
          }
        }
      });
    }
  });
</script>
